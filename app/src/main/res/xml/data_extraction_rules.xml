<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!-- App is stateless; disable backup/transfer of any app data. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>

</data-extraction-rules>

